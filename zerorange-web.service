[Unit]
Description=ZeroRange Web Companion
After=network.target
# Deliberately independent of zerorange.service — LCD must keep working if this crashes.

[Service]
Type=simple
User=sam
WorkingDirectory=/home/sam/ZeroRange
ExecStart=/usr/bin/python3 app/web/wsgi.py
Restart=on-failure
RestartSec=5s
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
